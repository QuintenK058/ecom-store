<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#1F3D34">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    {%- comment -%} Only the two critical font files are preloaded (display roman + body). {%- endcomment -%}
    {{ 'newsreader-var.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'hanken-grotesk-var.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.tagged' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {{ 'tokens.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <script>
      window.Lastly = {
        routes: {
          root: {{ routes.root_url | json }},
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cartChange: {{ routes.cart_change_url | append: '.js' | json }},
          cartUpdate: {{ routes.cart_update_url | append: '.js' | json }},
          cart: {{ routes.cart_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        currency: {{ cart.currency.iso_code | json }},
        moneyFormat: {{ shop.money_format | json }},
        checkout: {
          provider: {{ settings.checkout_provider | json }},
          whopUrl: {{ settings.whop_checkout_url | json }}
        },
        shipping: {
          freeThreshold: {{ settings.free_shipping_threshold | times: 100 | json }},
          minDays: {{ settings.ship_min_days | json }},
          maxDays: {{ settings.ship_max_days | json }},
          cutoffHour: {{ settings.ship_cutoff_hour | json }}
        },
        strings: {
          addToCart: {{ 'products.add_to_cart' | t | json }},
          soldOut: {{ 'products.sold_out' | t | json }},
          unavailable: {{ 'products.unavailable' | t | json }},
          adding: {{ 'products.adding' | t | json }},
          cartError: {{ 'cart.error' | t | json }}
        }
      };
    </script>
    <script src="{{ 'global.js' | asset_url }}" defer></script>
    <script src="{{ 'analytics.js' | asset_url }}" defer></script>
    <script src="{{ 'checkout-handoff.js' | asset_url }}" defer></script>
    <script src="{{ 'cart.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-link visually-hidden-focusable" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}

    <div class="toast" role="status" aria-live="polite" data-toast hidden></div>
  </body>
</html>
