[
  {
    "name": "theme_info",
    "theme_name": "Lastly",
    "theme_version": "1.0.0",
    "theme_author": "Lastly",
    "theme_documentation_url": "https://github.com/QuintenK058/ecom-store",
    "theme_support_url": "https://github.com/QuintenK058/ecom-store/issues"
  },
  {
    "name": "Brand",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo (optional — text wordmark is used if empty)" },
      { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 240, "step": 4, "unit": "px", "default": 112 },
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "32 x 32px PNG" },
      { "type": "image_picker", "id": "share_image", "label": "Default social share image" }
    ]
  },
  {
    "name": "Checkout",
    "settings": [
      {
        "type": "select",
        "id": "checkout_provider",
        "label": "Checkout provider",
        "info": "Handled in assets/checkout-handoff.js only.",
        "options": [
          { "value": "shopify", "label": "Shopify checkout" },
          { "value": "whop", "label": "Whop via Lasso" }
        ],
        "default": "shopify"
      },
      { "type": "url", "id": "whop_checkout_url", "label": "Whop / Lasso checkout URL", "info": "Used only when provider is Whop." },
      { "type": "checkbox", "id": "show_express_checkout", "label": "Show express payment buttons in cart", "default": true }
    ]
  },
  {
    "name": "Shipping & delivery",
    "settings": [
      { "type": "number", "id": "free_shipping_threshold", "label": "Free shipping threshold (store currency, whole number)", "default": 60 },
      { "type": "number", "id": "ship_min_days", "label": "Delivery estimate: min business days", "default": 3 },
      { "type": "number", "id": "ship_max_days", "label": "Delivery estimate: max business days", "default": 5 },
      { "type": "range", "id": "ship_cutoff_hour", "label": "Same-day ship cut-off (US Eastern, 24h)", "min": 8, "max": 20, "step": 1, "default": 14 },
      { "type": "text", "id": "returns_line", "label": "Returns / guarantee line", "default": "Free 30-day returns" }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      { "type": "product", "id": "cart_upsell_product", "label": "Cart upsell product", "info": "Falls back to Shopify complementary recommendations." },
      { "type": "collection", "id": "cart_empty_collection", "label": "Empty cart: bestsellers collection" }
    ]
  },
  {
    "name": "Reviews",
    "settings": [
      {
        "type": "paragraph",
        "content": "Star ratings read the standard reviews.rating and reviews.rating_count product metafields, written by your review app (Judge.me, Okendo, Yotpo, Shopify Product Reviews). Nothing is shown until real reviews exist."
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" },
      { "type": "text", "id": "social_pinterest", "label": "Pinterest URL" },
      { "type": "text", "id": "social_youtube", "label": "YouTube URL" }
    ]
  }
]
