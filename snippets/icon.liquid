{%- comment -%}
  Inline SVG icon set. 24px grid, 1.5px stroke, round caps (see docs/brand.md → Iconography).
  Usage: {% render 'icon', name: 'shield', class: 'icon--sm' %}
  Decorative by default (aria-hidden). Pass label: 'Text' for a meaningful icon.
{%- endcomment -%}
<svg
  class="icon icon--{{ name }} {{ class }}"
  viewBox="0 0 24 24"
  {% if label %}role="img" aria-label="{{ label | escape }}"{% else %}aria-hidden="true" focusable="false"{% endif %}
>
  {%- case name -%}
    {%- when 'menu' -%}<path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'close' -%}<path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'search' -%}<circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/>
    {%- when 'bag' -%}<path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>
    {%- when 'user' -%}<circle cx="12" cy="8.5" r="3.5"/><path d="M5 20c1.2-3.5 4-5 7-5s5.8 1.5 7 5"/>
    {%- when 'chevron-down' -%}<path d="m6 9 6 6 6-6"/>
    {%- when 'chevron-right' -%}<path d="m9 6 6 6-6 6"/>
    {%- when 'chevron-left' -%}<path d="m15 6-6 6 6 6"/>
    {%- when 'arrow-right' -%}<path d="M4 12h15M14 7l5 5-5 5"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'check' -%}<path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'x' -%}<path d="M7 7l10 10M17 7 7 17"/>
    {%- when 'truck' -%}<path d="M3 6h11v10H3zM14 9h4l3 3.5V16h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>
    {%- when 'return' -%}<path d="M9 7 5 11l4 4"/><path d="M5 11h9a5 5 0 0 1 0 10h-2"/>
    {%- when 'shield' -%}<path d="M12 3 5 6v5.5c0 4.3 3 7.8 7 9.5 4-1.7 7-5.2 7-9.5V6l-7-3Z"/><path d="m9 12 2.2 2.2L15.5 10"/>
    {%- when 'lock' -%}<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/>
    {%- when 'battery' -%}<rect x="3" y="7.5" width="16" height="9" rx="2"/><path d="M21 10.5v3M6.5 10.5v3M9.5 10.5v3M12.5 10.5v3"/>
    {%- when 'usb-c' -%}<rect x="5" y="9" width="14" height="6" rx="3"/><path d="M9 12h6M12 3v6M12 15v6"/>
    {%- when 'blade' -%}<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M12 4v5M12 15v5M4 12h5M15 12h5"/>
    {%- when 'sweater' -%}<path d="M8.5 4 4 6.5 3 13l3 .5V20h12v-6.5l3-.5-1-6.5L15.5 4a3.5 3.5 0 0 1-7 0Z"/><path d="M9 16h6"/>
    {%- when 'couch' -%}<path d="M5 11V8a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v3"/><path d="M3 13a2 2 0 0 1 4 0v2h10v-2a2 2 0 0 1 4 0v5H3v-5Z"/><path d="M5 18v2M19 18v2"/>
    {%- when 'clock' -%}<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
    {%- when 'star' -%}<path d="m12 4 2.4 4.9 5.4.8-3.9 3.8.9 5.4L12 16.4 7.2 19l.9-5.4-3.9-3.8 5.4-.8L12 4Z"/>
    {%- when 'leaf' -%}<path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14Z"/><path d="M5 19 13 11"/>
    {%- when 'sparkle' -%}<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/>
    {%- when 'mail' -%}<rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="m4 7 8 6 8-6"/>
    {%- when 'chat' -%}<path d="M4 5h16v11H9l-5 4V5Z"/>
    {%- when 'gift' -%}<rect x="4" y="9" width="16" height="11" rx="1"/><path d="M3 9h18M12 9v11M12 9S10.5 4 8 4.8C6 5.5 7.5 9 12 9Zm0 0s1.5-5 4-4.2C18 5.5 16.5 9 12 9Z"/>
    {%- when 'pause' -%}<path d="M9 6v12M15 6v12"/>
    {%- when 'play' -%}<path d="M8 5.5v13l10-6.5-10-6.5Z"/>
    {%- when 'zoom' -%}<circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4M11 8.5v5M8.5 11h5"/>
    {%- when 'verified' -%}<circle cx="12" cy="12" r="8.5"/><path d="m8.5 12 2.5 2.5 4.5-5"/>
    {%- when 'calendar' -%}<rect x="4" y="5.5" width="16" height="15" rx="2"/><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4"/>
    {%- when 'pin' -%}<path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0C18.5 15 12 21 12 21Z"/><circle cx="12" cy="10" r="2.3"/>
    {%- else -%}<circle cx="12" cy="12" r="8"/>
  {%- endcase -%}
</svg>
