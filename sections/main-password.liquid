<div class="container container--narrow section center stack" {{ section.shopify_attributes }}>
  <span class="wordmark">{{ shop.name | escape }}</span>
  <h1 class="h0">{{ section.settings.heading }}</h1>
  <p class="lead">{{ section.settings.text | escape }}</p>
  {%- form 'customer', class: 'final-cta__form', id: 'PasswordNewsletter' -%}
    <input type="hidden" name="contact[tags]" value="newsletter,prelaunch">
    <div class="inline-form">
      <label class="visually-hidden" for="PasswordEmail">{{ 'newsletter.label' | t }}</label>
      <input id="PasswordEmail" class="input" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}" required>
      <button type="submit" class="button">Notify me</button>
    </div>
    {%- if form.posted_successfully? -%}<p class="form-message form-message--success mt-2" role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
  {%- endform -%}
  <details class="accordion mt-6">
    <summary>{{ 'password.enter' | t }} {% render 'icon', name: 'plus', class: 'icon--plus' %}</summary>
    {%- form 'storefront_password', class: 'inline-form accordion__content' -%}
      <label class="visually-hidden" for="StorePassword">{{ 'password.password' | t }}</label>
      <input id="StorePassword" class="input" type="password" name="password" autocomplete="current-password" required>
      <button type="submit" class="button button--secondary">{{ 'password.submit' | t }}</button>
      {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </details>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Keep the sweater. <em>Lose the pills.</em>" },
    { "type": "text", "id": "text", "label": "Text", "default": "We're opening soon. Get 10% off launch day." }
  ]
}
{% endschema %}
