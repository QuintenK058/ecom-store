{%- comment -%} /cart fallback page (the drawer is the primary cart). {%- endcomment -%}
<div class="container container--narrow section" {{ section.shopify_attributes }}>
  <h1 class="h1 mb-4">{{ 'cart.title' | t }}</h1>
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" data-checkout>
      <ul class="cart-items" role="list">
        {%- for item in cart.items -%}
          <li class="cart-item">
            <a href="{{ item.url }}" class="media media--square" tabindex="-1" aria-hidden="true">
              {%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '88px', alt: '' }}{%- endif -%}
            </a>
            <div>
              <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
              {%- unless item.product.has_only_default_variant -%}<p class="cart-item__meta">{{ item.variant.title | escape }}</p>{%- endunless -%}
              <div class="cart-item__row">
                <div class="field">
                  <label class="visually-hidden" for="CartQty-{{ forloop.index }}">{{ 'accessibility.quantity' | t }}, {{ item.product.title | escape }}</label>
                  <input id="CartQty-{{ forloop.index }}" class="input" type="number" name="updates[]" value="{{ item.quantity }}" min="0" data-cart-page-qty>
                </div>
                <span class="tabular">{{ item.final_line_price | money }}</span>
              </div>
              <a class="cart-item__remove" href="{{ item.url_to_remove }}">Remove</a>
            </div>
          </li>
        {%- endfor -%}
      </ul>
      <div class="cart-summary mt-6">
        <div class="cart-summary__row cart-summary__total"><span>{{ 'cart.subtotal' | t }}</span><span class="tabular">{{ cart.total_price | money_with_currency }}</span></div>
        <div class="field">
          <label for="CartNote">{{ 'cart.note' | t }}</label>
          <textarea id="CartNote" class="textarea" name="note">{{ cart.note }}</textarea>
        </div>
        <button type="submit" name="update" class="button button--secondary">Update cart</button>
        <button type="submit" name="checkout" class="button button--full button--large" data-track="cart-page-checkout">{{ 'cart.checkout' | t }}</button>
        {%- if additional_checkout_buttons and settings.checkout_provider == 'shopify' -%}
          <div class="cart-express">{{ content_for_additional_checkout_buttons }}</div>
        {%- endif -%}
        <p class="text-sm text-muted">{{ 'cart.taxes_shipping' | t }}</p>
      </div>
    </form>
  {%- else -%}
    <div class="cart-empty">
      <p class="lead">{{ 'cart.empty' | t }}</p>
      <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.empty_cta' | t }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
