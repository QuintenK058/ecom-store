{%- assign s = section.settings -%}
<section class="section" id="use-cases" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section-header">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="h1">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="lead">{{ s.text | escape }}</p>{%- endif -%}
    </div>
    <ul class="tiles" role="list">
      {%- for block in section.blocks limit: 4 -%}
        <li {{ block.shopify_attributes }}>
          <a class="tile" href="{{ block.settings.link | default: routes.all_products_collection_url }}" data-track="tile-{{ forloop.index }}">
            <div class="media">
              {%- if block.settings.image -%}
                {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 450, 600, 800', sizes: '(min-width: 1024px) 25vw, 50vw', alt: '' }}
              {%- else -%}
                {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <span class="tile__label">
              <span>{{ block.settings.title | escape }}</span>
              {% render 'icon', name: 'arrow-right' %}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Use-case tiles",
  "class": "section-tiles",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Works on" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "More than <em>sweaters.</em>" },
    { "type": "text", "id": "text", "label": "Text", "default": "Anything that pills: knits, coats, blankets, upholstery." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (4:5)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Sweaters & knits" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Use-case tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "Sweaters & cashmere" } },
        { "type": "tile", "settings": { "title": "Coats & wool" } },
        { "type": "tile", "settings": { "title": "Couches & throws" } },
        { "type": "tile", "settings": { "title": "Leggings & fleece" } }
      ]
    }
  ]
}
{% endschema %}
