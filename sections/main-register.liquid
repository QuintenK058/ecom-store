<div class="container section" {{ section.shopify_attributes }}>
  <div class="auth-card">
    <h1 class="h1">{{ 'customer.register' | t }}</h1>
    {%- form 'create_customer', class: 'stack', novalidate: 'novalidate' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="RegFirst">{{ 'customer.first_name' | t }}</label><input id="RegFirst" class="input" type="text" name="customer[first_name]" autocomplete="given-name"></div>
      <div class="field"><label for="RegLast">{{ 'customer.last_name' | t }}</label><input id="RegLast" class="input" type="text" name="customer[last_name]" autocomplete="family-name"></div>
      <div class="field"><label for="RegEmail">{{ 'customer.email' | t }}</label><input id="RegEmail" class="input" type="email" name="customer[email]" autocomplete="email" required></div>
      <div class="field"><label for="RegPassword">{{ 'customer.password' | t }}</label><input id="RegPassword" class="input" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <label class="checkbox"><input type="checkbox" name="customer[accepts_marketing]" value="true"> Email me care tips and offers</label>
      <button type="submit" class="button button--full">{{ 'customer.register' | t }}</button>
    {%- endform -%}
  </div>
</div>
{% schema %}
{ "name": "Register", "settings": [] }
{% endschema %}
