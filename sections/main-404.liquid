<div class="container section not-found" {{ section.shopify_attributes }}>
  <p class="not-found__code" aria-hidden="true">404</p>
  <h1 class="h1">{{ 'errors.not_found_title' | t }}</h1>
  <p class="lead">{{ 'errors.not_found_text' | t }}</p>
  <div class="cluster">
    <a class="button" href="{{ routes.all_products_collection_url }}" data-track="404-shop">{{ 'cart.empty_cta' | t }}</a>
    <a class="button button--secondary" href="{{ routes.root_url }}">{{ 'errors.not_found_cta' | t }}</a>
  </div>
</div>

{% schema %}
{ "name": "404", "settings": [] }
{% endschema %}
