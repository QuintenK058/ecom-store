{%- comment -%} Image + text. Used for founder story, benefit rows (alternate with "Image on right"). {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="section{% if s.style == 'raised' %} section--raised{% elsif s.style == 'inverse' %} section--inverse{% elsif s.style == 'tint' %} section--tint{% endif %}" {{ section.shopify_attributes }}>
  <div class="container split{% if s.reverse %} split--reverse{% endif %}">
    <div class="split__media">
      <div class="media media--{{ s.ratio }}">
        {%- if s.image -%}
          {{ s.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200, 1600', sizes: '(min-width: 768px) 50vw, 100vw', alt: s.image.alt | default: '' }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>
    <div class="split__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}<p class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
          {%- when 'heading' -%}<h2 class="h1" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
          {%- when 'text' -%}<div class="rte lead" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'bullet' -%}
            <ul class="split__list" role="list" {{ block.shopify_attributes }}>
              <li>{% render 'icon', name: block.settings.icon %}<span>{{ block.settings.text | escape }}</span></li>
            </ul>
          {%- when 'signature' -%}<p class="signature" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
          {%- when 'button' -%}
            <a class="button{% if block.settings.secondary %} button--secondary{% endif %}{% if s.style == 'inverse' %} button--light{% endif %}" href="{{ block.settings.link }}" data-track="iwt-{{ section.id }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "class": "section-split",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "ratio", "label": "Image ratio", "options": [{ "value": "portrait", "label": "4:5" }, { "value": "square", "label": "1:1" }, { "value": "landscape", "label": "3:2" }], "default": "portrait" },
    { "type": "checkbox", "id": "reverse", "label": "Image on right", "default": false },
    { "type": "select", "id": "style", "label": "Background", "options": [{ "value": "none", "label": "None" }, { "value": "raised", "label": "Linen" }, { "value": "tint", "label": "Fir tint" }, { "value": "inverse", "label": "Fir (dark)" }], "default": "none" }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Eyebrow", "limit": 1, "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Our story" }] },
    { "type": "heading", "name": "Heading", "limit": 1, "settings": [{ "type": "inline_richtext", "id": "text", "label": "Text", "default": "Heading" }] },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell a short, specific story.</p>" }] },
    {
      "type": "bullet",
      "name": "Bullet",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [{ "value": "check", "label": "Check" }, { "value": "shield", "label": "Shield" }, { "value": "battery", "label": "Battery" }, { "value": "usb-c", "label": "USB-C" }, { "value": "blade", "label": "Blade" }, { "value": "leaf", "label": "Leaf" }], "default": "check" },
        { "type": "text", "id": "text", "label": "Text", "default": "Benefit" }
      ]
    },
    { "type": "signature", "name": "Signature", "limit": 1, "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "— [Founder name], founder" }] },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Read our story" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "secondary", "label": "Secondary style", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text",
      "blocks": [
        { "type": "eyebrow" },
        { "type": "heading" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
