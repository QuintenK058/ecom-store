{%- liquid
  assign columns = section.blocks | where: 'type', 'menu'
-%}
<footer class="footer" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="footer__top">
      <div class="footer__newsletter">
        <p class="h2">{{ section.settings.newsletter_heading | escape }}</p>
        <p class="text-muted">{{ section.settings.newsletter_text | escape }}</p>
        {%- form 'customer', id: 'FooterNewsletter', class: 'stack-sm' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,footer">
          <div class="inline-form">
            <label class="visually-hidden" for="FooterNewsletterEmail">{{ 'newsletter.label' | t }}</label>
            <input
              id="FooterNewsletterEmail"
              class="input"
              type="email"
              name="contact[email]"
              autocomplete="email"
              placeholder="{{ 'newsletter.placeholder' | t }}"
              required
              {% if form.errors %}aria-invalid="true" aria-describedby="FooterNewsletterError"{% endif %}
            >
            <button type="submit" class="button button--light" data-track="footer-newsletter">{{ 'newsletter.submit' | t }}</button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success" role="status">{{ 'newsletter.success' | t }}</p>
          {%- elsif form.errors -%}
            <p class="form-message form-message--error" id="FooterNewsletterError" role="alert">{{ 'newsletter.error' | t }}</p>
          {%- endif -%}
          <p class="text-xs text-muted">{{ section.settings.newsletter_legal | escape }}</p>
        {%- endform -%}
      </div>

      <div class="footer__cols">
        {%- for block in columns -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            <h2>{{ block.settings.heading | escape }}</h2>
            <ul role="list">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endfor -%}
        <div class="footer__col">
          <h2>{{ section.settings.contact_heading | escape }}</h2>
          <ul role="list">
            {%- if section.settings.email != blank -%}
              <li><a href="mailto:{{ section.settings.email }}">{{ section.settings.email | escape }}</a></li>
            {%- endif -%}
            <li class="text-muted">{{ section.settings.hours | escape }}</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      {% render 'social-icons' %}
      {%- if section.settings.show_payment_icons -%}
        <ul class="footer__payments" role="list" aria-label="Accepted payment methods">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <div class="footer__legal">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span>
        {%- for policy in shop.policies -%}
          <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
        {%- endfor -%}
      </div>
    </div>

    <p class="footer__wordmark" aria-hidden="true">{{ shop.name | escape }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 3,
  "settings": [
    { "type": "header", "content": "Newsletter" },
    { "type": "text", "id": "newsletter_heading", "label": "Heading", "default": "Care tips, not spam." },
    { "type": "text", "id": "newsletter_text", "label": "Text", "default": "Get 10% off your first order, plus a once-a-month note on keeping good clothes good." },
    { "type": "text", "id": "newsletter_legal", "label": "Legal line", "default": "Unsubscribe anytime. We never share your email." },
    { "type": "header", "content": "Contact" },
    { "type": "text", "id": "contact_heading", "label": "Heading", "default": "Talk to a human" },
    { "type": "text", "id": "email", "label": "Support email", "default": "[hello@lastlygoods.com]" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Mon–Fri, 9am–5pm ET. Replies within one business day." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
