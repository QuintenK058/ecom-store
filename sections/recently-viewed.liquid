{%- comment -%}
  Recently viewed. The section renders its grid from a search request (handle:x OR handle:y),
  which product.js triggers with ?section_id=<this section>. Hidden when nothing to show.
{%- endcomment -%}
{%- if search.performed -%}
  <ul class="product-grid product-grid--4" role="list" data-recent-grid>
    {%- for item in search.results limit: 4 -%}
      {%- if item.object_type == 'product' -%}
        <li>{% render 'product-card', product: item, track: 'recent' %}</li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- else -%}
  <recently-viewed class="section" data-section-id="{{ section.id }}" data-exclude="{{ product.handle }}" hidden {{ section.shopify_attributes }}>
    <div class="container">
      <div class="section-header"><h2 class="h2">{{ section.settings.heading | escape }}</h2></div>
      <ul class="product-grid product-grid--4" role="list" data-recent-grid></ul>
    </div>
  </recently-viewed>
{%- endif -%}

{% schema %}
{
  "name": "Recently viewed",
  "class": "section-recent",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" }
  ],
  "presets": [{ "name": "Recently viewed" }]
}
{% endschema %}
