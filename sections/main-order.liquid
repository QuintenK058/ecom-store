<div class="container section" {{ section.shopify_attributes }}>
  <p><a class="link-arrow" href="{{ routes.account_url }}">{% render 'icon', name: 'chevron-left', class: 'icon--sm' %} {{ 'customer.back_to_account' | t }}</a></p>
  <header class="page-header">
    <h1 class="h1">{{ 'customer.order' | t }} {{ order.name }}</h1>
    <p class="text-muted">{{ order.created_at | date: '%a, %b %-d, %Y' }}</p>
    {%- if order.cancelled -%}{%- assign cancelled_date = order.cancelled_at | date: '%b %-d, %Y' -%}<p class="form-message form-message--error">{{ 'customer.cancelled' | t: date: cancelled_date }}</p>{%- endif -%}
  </header>
  <div class="account-grid">
    <div class="compare">
      <table class="data-table">
        <thead><tr><th scope="col">{{ 'customer.product' | t }}</th><th scope="col">{{ 'customer.quantity' | t }}</th><th scope="col">{{ 'customer.total' | t }}</th></tr></thead>
        <tbody>
          {%- for item in order.line_items -%}
            <tr>
              <td>{{ item.title | escape }}{% if item.fulfillment %}<br><span class="text-xs text-muted">{{ item.fulfillment.tracking_company }} {% if item.fulfillment.tracking_url %}<a class="link" href="{{ item.fulfillment.tracking_url }}">Track</a>{% endif %}</span>{% endif %}</td>
              <td>{{ item.quantity }}</td>
              <td class="tabular">{{ item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot>
          <tr><th scope="row" colspan="2">{{ 'customer.subtotal' | t }}</th><td class="tabular">{{ order.line_items_subtotal_price | money }}</td></tr>
          {%- for shipping_method in order.shipping_methods -%}<tr><th scope="row" colspan="2">{{ 'customer.shipping' | t }} ({{ shipping_method.title }})</th><td class="tabular">{{ shipping_method.price | money }}</td></tr>{%- endfor -%}
          <tr><th scope="row" colspan="2">{{ 'customer.tax' | t }}</th><td class="tabular">{{ order.tax_price | money }}</td></tr>
          <tr><th scope="row" colspan="2">{{ 'customer.total' | t }}</th><td class="tabular"><strong>{{ order.total_price | money_with_currency }}</strong></td></tr>
        </tfoot>
      </table>
    </div>
    <aside class="stack">
      <h2 class="h4">{{ 'customer.shipping_address' | t }}</h2>
      <p class="text-muted">{{ order.shipping_address | format_address }}</p>
      <h2 class="h4">{{ 'customer.billing_address' | t }}</h2>
      <p class="text-muted">{{ order.billing_address | format_address }}</p>
    </aside>
  </div>
</div>
{% schema %}
{ "name": "Order", "settings": [] }
{% endschema %}
