<div class="container section" {{ section.shopify_attributes }}>
  <div class="auth-card">
    <h1 class="h1">{{ 'customer.reset_password' | t }}</h1>
    {%- form 'reset_customer_password', class: 'stack' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ResetPassword">{{ 'customer.password' | t }}</label><input id="ResetPassword" class="input" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label for="ResetConfirm">{{ 'customer.confirm_password' | t }}</label><input id="ResetConfirm" class="input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button type="submit" class="button button--full">{{ 'customer.reset_password' | t }}</button>
    {%- endform -%}
  </div>
</div>
{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
