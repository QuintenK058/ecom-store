{%- comment -%}
  Homepage hero-product block with variant buttons + 1-tap add to cart (quick add).
  Single-product brands convert better when the product is buyable on the homepage.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign product = s.product
  assign current = product.selected_or_first_available_variant
-%}
{{ 'product.css' | asset_url | stylesheet_tag }}
<section class="section{% if s.raised %} section--raised{% endif %}" id="spotlight" {{ section.shopify_attributes }}>
  <div class="container split">
    <div class="split__media">
      <div class="media media--square">
        {%- if s.image -%}
          {{ s.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200, 1600', sizes: '(min-width: 768px) 50vw, 100vw', alt: s.image.alt | default: product.title }}
        {%- elsif product.featured_media -%}
          {{ product.featured_media | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200, 1600', sizes: '(min-width: 768px) 50vw, 100vw', alt: product.featured_media.alt | default: product.title }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>
    <div class="split__content">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if product != blank -%}
        {%- assign reviews_link = product.url | append: '#reviews' -%}
        {% render 'rating', product: product, link: reviews_link %}
        <h2 class="h1">{{ s.heading | default: product.title }}</h2>
        {% render 'price', product: product, size: 'large' %}
        {%- if s.text != blank -%}<div class="lead rte">{{ s.text }}</div>{%- endif -%}

        {%- assign benefits = product.metafields.custom.benefits.value -%}
        {%- if benefits != blank -%}
          <ul class="benefits" role="list">
            {%- for b in benefits limit: 4 -%}
              <li>{% render 'icon', name: 'check' %} {{ b | escape }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <product-form class="pdp__buy w-full">
          {%- form 'product', product, data-product-form: '' -%}
            <input type="hidden" name="quantity" value="1">
            {%- if product.has_only_default_variant -%}
              <input type="hidden" name="id" value="{{ current.id }}">
            {%- else -%}
              <fieldset class="option">
                <legend>{{ product.options.first | escape }}</legend>
                <div class="option__values">
                  {%- for variant in product.variants -%}
                    <input
                      type="radio"
                      name="id"
                      id="Spotlight-{{ section.id }}-{{ variant.id }}"
                      value="{{ variant.id }}"
                      {% if variant.id == current.id %}checked{% endif %}
                      {% unless variant.available %}disabled{% endunless %}
                    >
                    <label class="option__btn" for="Spotlight-{{ section.id }}-{{ variant.id }}" {% unless variant.available %}data-sold-out="true"{% endunless %}>
                      {{- variant.title | escape -}}
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endif -%}
            <button type="submit" class="button button--full button--large mt-4" {% unless product.available %}disabled{% endunless %} data-track="spotlight-atc">
              {%- if product.available and s.button_label != blank -%}{{ s.button_label | escape }}{%- elsif product.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
            </button>
          {%- endform -%}
          <a class="link-arrow" href="{{ product.url }}" data-track="spotlight-details">{{ 'products.view_details' | t }} {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</a>
        </product-form>
      {%- else -%}
        <h2 class="h1">Choose a product</h2>
        <p class="text-muted">Select your hero product in the section settings.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product spotlight",
  "class": "section-spotlight",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Image override" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Meet the shaver" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading (defaults to product title)" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Wide head, [6] blades, and a rigid guard that doesn't flex — so a whole sweater takes about [5] minutes and never a hole.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to cart" },
    { "type": "checkbox", "id": "raised", "label": "Tinted background", "default": false }
  ],
  "presets": [{ "name": "Product spotlight" }]
}
{% endschema %}
