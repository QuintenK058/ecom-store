<div class="container section" {{ section.shopify_attributes }}>
  <h1 class="h1 mb-4">{{ section.settings.heading | escape }}</h1>
  <ul class="tiles" role="list">
    {%- for collection in collections -%}
      <li>
        <a class="tile" href="{{ collection.url }}">
          <div class="media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 1024px) 25vw, 50vw', alt: '' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <span class="tile__label"><span>{{ collection.title | escape }}</span>{% render 'icon', name: 'arrow-right' %}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{ "name": "Collections list", "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Shop" }] }
{% endschema %}
