{%- liquid
  assign s = section.settings
  assign per_page = s.per_page
-%}
{{ 'collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer></script>

{%- paginate collection.products by per_page -%}
  <div class="container" {{ section.shopify_attributes }}>
    <header class="collection-header">
      <h1 class="h1">{{ collection.title | escape }}</h1>
      {%- assign tagline = collection.metafields.custom.tagline.value | default: s.fallback_tagline -%}
      {%- if tagline != blank -%}<p class="text-muted">{{ tagline | escape }}</p>{%- endif -%}
    </header>

    <facet-filters-form data-section-id="{{ section.id }}">
      <div class="facets-bar">
        <button type="button" class="button button--secondary button--small facets-bar__filter-btn" data-drawer-open="FacetDrawer" aria-controls="FacetDrawer" aria-expanded="false" data-track="collection-filter">
          {{ 'collections.filter_and_sort' | t }}
        </button>
        <p class="facets-bar__count" data-facet-count role="status">{{ 'collections.product_count' | t: count: collection.products_count }}</p>
        {%- if s.enable_sort -%}
          <div class="facets-sort">
            <label for="SortBy-{{ section.id }}">{{ 'collections.sort_by' | t }}</label>
            <select id="SortBy-{{ section.id }}" class="select" name="sort_by" data-sort-select form="FacetFormSidebar">
              {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name | escape }}</option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}
      </div>

      <div class="active-facets" data-facet-active>{% render 'active-facets', results: collection %}</div>
      <p class="visually-hidden" aria-live="polite" data-facet-live></p>

      <div class="collection-layout{% if s.enable_filtering and collection.filters.size > 0 %} collection-layout--sidebar{% endif %}">
        {%- if s.enable_filtering and collection.filters.size > 0 -%}
          <aside class="facets-sidebar" aria-label="{{ 'collections.filter' | t }}">
            <form id="FacetFormSidebar" data-facet-sidebar>
              {% render 'facets', results: collection, location: 'sidebar' %}
              <noscript><button type="submit" class="button button--small mt-4">{{ 'collections.apply' | t }}</button></noscript>
            </form>
          </aside>
        {%- else -%}
          <form id="FacetFormSidebar" hidden></form>
        {%- endif -%}

        <div data-facet-results>
          {%- if collection.products.size == 0 -%}
            <div class="empty-state">
              <p class="h2">{% if collection.filters.size > 0 and collection.products_count == 0 %}{{ 'collections.empty' | t }}{% else %}{{ 'collections.no_results' | t }}{% endif %}</p>
              <a class="button" href="{{ collection.url }}" data-facet-link>{{ 'collections.clear_all' | t }}</a>
            </div>
          {%- else -%}
            <ul class="product-grid{% if s.columns == 4 %} product-grid--4{% endif %}" role="list" data-product-grid>
              {%- for product in collection.products -%}
                {%- liquid
                  assign promo_pos = s.promo_position | minus: 1
                  if forloop.index0 <= 3
                    assign card_loading = 'eager'
                  else
                    assign card_loading = 'lazy'
                  endif
                -%}
                {%- if forloop.index0 == promo_pos and paginate.current_page == 1 -%}
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'promo' -%}
                      <li class="grid-promo" {{ block.shopify_attributes }}>
                        {%- if block.settings.image -%}
                          <div class="media">{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 600, 900', sizes: '(min-width: 768px) 33vw, 100vw', alt: '' }}</div>
                        {%- endif -%}
                        <div class="grid-promo__content">
                          <p class="h2">{{ block.settings.heading | escape }}</p>
                          {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
                          {%- if block.settings.link != blank -%}
                            <a class="button button--light button--small" href="{{ block.settings.link }}" data-track="collection-promo">{{ block.settings.label | escape }}</a>
                          {%- endif -%}
                        </div>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
                <li>{% render 'product-card', product: product, loading: card_loading, track: 'collection' %}</li>
              {%- endfor -%}
            </ul>

            {%- liquid
              assign shown = paginate.current_offset | plus: collection.products.size
              assign total = paginate.items
              assign pct = shown | times: 100 | divided_by: total
            -%}
            <div class="collection-footer">
              <p class="text-sm text-muted" data-showing>{{ 'collections.showing' | t: shown: shown, total: total }}</p>
              <div class="collection-footer__bar" aria-hidden="true"><span style="--progress: {{ pct }}%;"></span></div>
              {%- if s.pagination == 'load_more' and paginate.next -%}
                <load-more data-next="{{ paginate.next.url }}" data-section-id="{{ section.id }}">
                  <button type="button" class="button button--secondary" data-track="collection-load-more">{{ 'collections.load_more' | t }}</button>
                </load-more>
              {%- elsif s.pagination == 'pages' -%}
                {% render 'pagination', paginate: paginate %}
              {%- endif -%}
              <noscript>{% render 'pagination', paginate: paginate %}</noscript>
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- if s.enable_filtering and collection.filters.size > 0 -%}
        <modal-drawer id="FacetDrawer" class="drawer" aria-hidden="true">
          <div class="drawer__overlay" data-drawer-close></div>
          <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'collections.filter_and_sort' | t }}">
            <div class="drawer__header">
              <h2 class="drawer__title">{{ 'collections.filter_and_sort' | t }}</h2>
              <button type="button" class="icon-button" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
            </div>
            <form class="drawer__body" id="FacetFormDrawer">
              <div data-facet-drawer-body>{% render 'facets', results: collection, location: 'drawer' %}</div>
            </form>
            <div class="drawer__footer cluster">
              <a class="button button--secondary" href="{{ collection.url }}" data-facet-link>{{ 'collections.clear_all' | t }}</a>
              <button type="button" class="button" data-drawer-close>{{ 'collections.apply' | t }}</button>
            </div>
          </div>
        </modal-drawer>
      {%- endif -%}
    </facet-filters-form>

    {%- if collection.description != blank -%}
      <details class="seo-text">
        <summary>{{ 'collections.read_more' | t }}: {{ collection.title | escape }}</summary>
        <div class="rte text-muted">{{ collection.description }}</div>
      </details>
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "class": "section-main-collection",
  "settings": [
    { "type": "text", "id": "fallback_tagline", "label": "Tagline (if collection has no custom.tagline)", "default": "Everything you need to keep good clothes good." },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 36, "step": 4, "default": 12 },
    { "type": "select", "id": "columns", "label": "Desktop columns", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "3" },
    { "type": "checkbox", "id": "enable_filtering", "label": "Enable filters", "default": true, "info": "Configure filters in the Search & Discovery app." },
    { "type": "checkbox", "id": "enable_sort", "label": "Enable sorting", "default": true },
    { "type": "select", "id": "pagination", "label": "Pagination", "options": [{ "value": "load_more", "label": "Load more" }, { "value": "pages", "label": "Numbered pages" }], "default": "load_more" },
    { "type": "range", "id": "promo_position", "label": "Promo tile position", "min": 2, "max": 12, "step": 1, "default": 5 }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo tile",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "The Pair: 2 for $89" },
        { "type": "text", "id": "text", "label": "Text", "default": "One for you, one to give." },
        { "type": "text", "id": "label", "label": "Button", "default": "Get the Pair" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
