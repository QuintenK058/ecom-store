<div class="container section" {{ section.shopify_attributes }}>
  <header class="page-header">
    <h1 class="h1">{{ 'customer.account' | t }}</h1>
    <p><a class="link" href="{{ routes.account_logout_url }}">{{ 'customer.logout' | t }}</a></p>
  </header>
  <div class="account-grid">
    <div>
      <h2 class="h2 mb-4">{{ 'customer.orders' | t }}</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <div class="compare">
            <table class="data-table">
              <thead><tr><th scope="col">{{ 'customer.order' | t }}</th><th scope="col">{{ 'customer.date' | t }}</th><th scope="col">{{ 'customer.payment_status' | t }}</th><th scope="col">{{ 'customer.fulfillment_status' | t }}</th><th scope="col">{{ 'customer.total' | t }}</th></tr></thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td><a class="link" href="{{ order.customer_url }}">{{ order.name }}</a></td>
                    <td>{{ order.created_at | date: '%b %-d, %Y' }}</td>
                    <td>{{ order.financial_status_label }}</td>
                    <td>{{ order.fulfillment_status_label }}</td>
                    <td class="tabular">{{ order.total_price | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        {%- else -%}
          <p class="text-muted">{{ 'customer.no_orders' | t }}</p>
          <a class="button mt-4" href="{{ routes.all_products_collection_url }}">{{ 'cart.empty_cta' | t }}</a>
        {%- endif -%}
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    </div>
    <aside class="stack">
      <h2 class="h3">{{ customer.name | escape }}</h2>
      {%- if customer.default_address -%}<p class="text-muted">{{ customer.default_address | format_address }}</p>{%- endif -%}
      <a class="link" href="{{ routes.account_addresses_url }}">{{ 'customer.view_addresses' | t: count: customer.addresses_count }}</a>
    </aside>
  </div>
</div>
{% schema %}
{ "name": "Account", "settings": [] }
{% endschema %}
