{%- comment -%}
  Frequently bought together: current product + complementary products.
  Source: Shopify complementary recommendations (Search & Discovery app) via the
  recommendations object (intent: complementary), falling back to a picked product list.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign extras = s.products
  if recommendations.performed and recommendations.products_count > 0
    assign extras = recommendations.products
  endif
  assign base = product.selected_or_first_available_variant
-%}
{{ 'product.css' | asset_url | stylesheet_tag }}
<section class="section section--raised" id="fbt" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section-header">
      <h2 class="h2">{% if s.heading != blank %}{{ s.heading | escape }}{% else %}{{ 'products.frequently_bought_together' | t }}{% endif %}</h2>
    </div>
    {%- if extras.size > 0 or extras.count > 0 -%}
      <product-form>
        {%- form 'product', product, class: 'fbt' -%}
          <fbt-picker data-base-price="{{ base.price }}">
            <input type="hidden" name="id" value="{{ base.id }}">
            <input type="hidden" name="quantity" value="1">
            <ul class="fbt__items" role="list">
              <li class="fbt__item">
                <input type="checkbox" checked disabled aria-label="{{ product.title | escape }} (this item)">
                <div class="media media--square">
                  {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '64px', alt: '' }}{%- endif -%}
                </div>
                <span><strong>This item:</strong> {{ product.title | escape }}</span>
                <span class="tabular">{{ base.price | money }}</span>
              </li>
              {%- for p in extras limit: 2 -%}
                {%- if p.id != product.id and p.available -%}
                  {%- assign pv = p.selected_or_first_available_variant -%}
                  <li class="fbt__item">
                    <input type="checkbox" id="fbt-{{ section.id }}-{{ p.id }}" value="{{ pv.id }}" data-extra-variant data-price="{{ pv.price }}" checked>
                    <div class="media media--square">
                      {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '64px', alt: '' }}{%- endif -%}
                    </div>
                    <label for="fbt-{{ section.id }}-{{ p.id }}">{{ p.title | escape }}</label>
                    <span class="tabular">{{ pv.price | money }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
            <div class="fbt__footer">
              <p>{{ 'products.total' | t }}: <strong class="tabular" data-fbt-total></strong></p>
              <button type="submit" class="button" data-track="fbt-add">{{ 'products.add_both' | t }}</button>
            </div>
          </fbt-picker>
        {%- endform -%}
      </product-form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bought together",
  "class": "section-fbt",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Keep it cutting clean" },
    { "type": "product_list", "id": "products", "label": "Fallback products", "limit": 2, "info": "Used when Shopify has no complementary products set (Search & Discovery app)." }
  ],
  "presets": [{ "name": "Frequently bought together" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
